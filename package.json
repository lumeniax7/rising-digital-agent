{
  "name": "rising-digital-agent",
  "version": "4.0.0",
  "description": "Agent IA autonome de Rising Digital Solutions (Togo) : publications sociales, assistant WhatsApp, CRM, rapports — 100% Cloudflare gratuit.",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute rds-agent --remote --file=migrations/0001_init.sql",
    "db:init:local": "wrangler d1 execute rds-agent --local --file=migrations/0001_init.sql"
  },
  "devDependencies": { "wrangler": "^4.0.0" },
  "engines": { "node": ">=20" }
}
